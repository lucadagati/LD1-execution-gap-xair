<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="industrial_cell">
  <xacro:arg name="controllers_yaml" default=""/>

  <link name="world"/>

  <!-- Fixed base / arm column -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.4"/>
      <geometry><box size="0.3 0.3 0.8"/></geometry>
      <material name="grey"><color rgba="0.45 0.45 0.48 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.4"/>
      <geometry><box size="0.3 0.3 0.8"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.4"/>
      <mass value="40"/>
      <inertia ixx="2.5" ixy="0" ixz="0" iyy="2.5" iyz="0" izz="1.5"/>
    </inertial>
  </link>

  <!-- Prismatic TCP slide (maps /UE_TCP_position.x) -->
  <link name="tcp_link">
    <visual>
      <origin xyz="0 0 0.05"/>
      <geometry><box size="0.12 0.12 0.1"/></geometry>
      <material name="orange"><color rgba="0.9 0.45 0.1 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.05"/>
      <geometry><box size="0.12 0.12 0.1"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.05"/>
      <mass value="2"/>
      <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.02"/>
    </inertial>
  </link>

  <!-- Conveyor belt roller (maps RESUME motion along line) -->
  <link name="conveyor_link">
    <visual>
      <origin xyz="0 0 0.03"/>
      <geometry><box size="0.5 0.4 0.06"/></geometry>
      <material name="dark"><color rgba="0.12 0.12 0.12 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.03"/>
      <geometry><box size="0.5 0.4 0.06"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.03"/>
      <mass value="5"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
  </link>

  <!-- Parallel gripper finger -->
  <link name="gripper_finger">
    <visual>
      <origin xyz="0 0.04 0.04"/>
      <geometry><box size="0.06 0.08 0.12"/></geometry>
      <material name="steel"><color rgba="0.6 0.62 0.65 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0.04 0.04"/>
      <geometry><box size="0.06 0.08 0.12"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0.04 0.04"/>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="world_to_base" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="world"/>
    <child link="base_link"/>
  </joint>

  <joint name="arm_slide_joint" type="prismatic">
    <parent link="base_link"/>
    <child link="tcp_link"/>
    <origin xyz="0 0 0.85" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.0" upper="1.0" effort="200" velocity="0.5"/>
  </joint>

  <joint name="conveyor_joint" type="revolute">
    <parent link="base_link"/>
    <child link="conveyor_link"/>
    <origin xyz="0.6 0 0.15" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-6.28" upper="6.28" effort="50" velocity="2.0"/>
  </joint>

  <joint name="gripper_joint" type="prismatic">
    <parent link="tcp_link"/>
    <child link="gripper_finger"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="0.08" effort="30" velocity="0.3"/>
  </joint>

  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="arm_slide_joint">
      <command_interface name="position">
        <param name="min">0.0</param>
        <param name="max">1.0</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.2</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="conveyor_joint">
      <command_interface name="position">
        <param name="min">-6.28</param>
        <param name="max">6.28</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="gripper_joint">
      <command_interface name="position">
        <param name="min">0.0</param>
        <param name="max">0.08</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.04</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg controllers_yaml)</parameters>
    </plugin>
  </gazebo>
</robot>
