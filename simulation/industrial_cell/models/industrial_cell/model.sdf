<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="industrial_cell">
    <pose>0 0 0.05 0 0 0</pose>
    <self_collide>false</self_collide>

    <link name="base_link">
      <inertial>
        <mass>40</mass>
        <inertia><ixx>2.5</ixx><iyy>2.5</iyy><izz>1.5</izz></inertia>
      </inertial>
      <visual name="visual">
        <geometry><box><size>0.3 0.3 0.8</size></box></geometry>
        <pose>0 0 0.4 0 0 0</pose>
        <material><ambient>0.45 0.45 0.48 1</ambient><diffuse>0.45 0.45 0.48 1</diffuse></material>
      </visual>
      <collision name="collision">
        <geometry><box><size>0.3 0.3 0.8</size></box></geometry>
        <pose>0 0 0.4 0 0 0</pose>
      </collision>
    </link>

    <link name="tcp_link">
      <inertial>
        <mass>2</mass>
        <inertia><ixx>0.02</ixx><iyy>0.02</iyy><izz>0.02</izz></inertia>
      </inertial>
      <visual name="visual">
        <geometry><box><size>0.12 0.12 0.1</size></box></geometry>
        <pose>0 0 0.05 0 0 0</pose>
        <material><ambient>0.9 0.45 0.1 1</ambient><diffuse>0.9 0.45 0.1 1</diffuse></material>
      </visual>
      <collision name="collision">
        <geometry><box><size>0.12 0.12 0.1</size></box></geometry>
        <pose>0 0 0.05 0 0 0</pose>
      </collision>
    </link>

    <link name="conveyor_link">
      <inertial>
        <mass>5</mass>
        <inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz></inertia>
      </inertial>
      <visual name="visual">
        <geometry><box><size>0.5 0.4 0.06</size></box></geometry>
        <pose>0 0 0.03 0 0 0</pose>
        <material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material>
      </visual>
    </link>

    <link name="gripper_finger">
      <inertial>
        <mass>0.5</mass>
        <inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia>
      </inertial>
      <visual name="visual">
        <geometry><box><size>0.06 0.08 0.12</size></box></geometry>
        <pose>0 0.04 0.04 0 0 0</pose>
        <material><ambient>0.6 0.62 0.65 1</ambient><diffuse>0.6 0.62 0.65 1</diffuse></material>
      </visual>
    </link>

    <joint name="arm_slide_joint" type="prismatic">
      <parent>base_link</parent>
      <child>tcp_link</child>
      <pose>0 0 0.85 0 0 0</pose>
      <axis>
        <xyz>1 0 0</xyz>
        <limit><lower>0</lower><upper>1</upper></limit>
        <dynamics><damping>0.5</damping></dynamics>
      </axis>
    </joint>

    <joint name="conveyor_joint" type="revolute">
      <parent>base_link</parent>
      <child>conveyor_link</child>
      <pose>0.6 0 0.15 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-6.28</lower><upper>6.28</upper></limit>
        <dynamics><damping>1.0</damping></dynamics>
      </axis>
    </joint>

    <joint name="gripper_joint" type="prismatic">
      <parent>tcp_link</parent>
      <child>gripper_finger</child>
      <pose>0 0 0.1 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>0</lower><upper>0.08</upper></limit>
        <dynamics><damping>0.2</damping></dynamics>
      </axis>
    </joint>

    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <joint_name>arm_slide_joint</joint_name>
      <joint_name>conveyor_joint</joint_name>
      <joint_name>gripper_joint</joint_name>
    </plugin>

    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>arm_slide_joint</joint_name>
      <topic>/model/industrial_cell/joint/arm_slide_joint/cmd_vel</topic>
      <initial_velocity>0</initial_velocity>
    </plugin>

    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>conveyor_joint</joint_name>
      <topic>/model/industrial_cell/joint/conveyor_joint/cmd_vel</topic>
      <initial_velocity>0</initial_velocity>
    </plugin>

    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>gripper_joint</joint_name>
      <topic>/model/industrial_cell/joint/gripper_joint/cmd_vel</topic>
      <initial_velocity>0</initial_velocity>
    </plugin>
  </model>
</sdf>
